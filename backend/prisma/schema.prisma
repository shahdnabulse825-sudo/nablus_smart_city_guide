// مخطط قاعدة البيانات الحقيقي لتطبيق دليل نابلس الذكي (SQLite عبر Prisma)
// قاعدة بيانات حقيقية محفوظة كملف واحد جوا مجلد backend نفسه (backend/prisma/dev.db)
// — بدون تسجيل حساب، بدون رابط اتصال، بدون إنترنت. تشتغل فورًا بمجرد تشغيل السيرفر.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== المستخدمون ====================
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("user") // "user" | "admin"
  createdAt    DateTime @default(now())

  // ثلاث اشتراكات Premium منفصلة (à la carte) للمساعد الذكي — كل وحدة تُشترى
  // لحالها بسعرها الخاص (لا يوجد بوابة دفع حقيقية بهذا المشروع الأكاديمي،
  // "دفع وهمي" بالكامل يُفعّل الحقل المناسب مباشرة لغرض العرض التوضيحي):
  // premiumText: أسئلة نصية غير محدودة (بيفتح كمان حد مخطط الرحلة وراوي
  // الجولات، لأنهم بيستخدموا نفس حصة النص). premiumVoice: استماع صوتي غير
  // محدود. premiumPriority: يضمن استخدام النموذج الأقوى بكل الأسئلة، مش بس
  // بتخطيط الرحلة/الرواية.
  premiumText     Boolean @default(false)
  premiumVoice    Boolean @default(false)
  premiumPriority Boolean @default(false)
  // عداد استخدام يومي للمستخدم المجاني (نص/صوت) — يُصفَّر تلقائيًا كل ما يتغيّر
  // aiUsageDate عن تاريخ اليوم الحالي، بدل جدولة مهمة صفر منفصلة.
  aiTextCount  Int      @default(0)
  aiVoiceCount Int      @default(0)
  aiUsageDate  String   @default("")
}

// ==================== الأماكن العامة (مواصلات، صحة، تعليم، بنوك، ترفيه، حكومي فقط) ====================
// ملاحظة: الفنادق/الصيدليات/المعالم/التسوق كل وحدة إلها نموذج مخصص تحت (نفس بنية
// التطبيق بـ Flutter اللي بنى وحدة مستقلة لكل قسم غني بدل النموذج العام).
model Listing {
  id                String   @id @default(cuid())
  category          String // transport | health | education | banks | entertainment | government
  nameAr            String
  nameEn            String
  typeAr            String
  typeEn            String
  locationAr        String
  locationEn        String
  rating            Float    @default(4.0)
  reviews           Int      @default(0)
  infoLabelAr       String   @default("")
  infoLabelEn       String   @default("")
  aboutAr           String   @default("")
  aboutEn           String   @default("")
  phone             String   @default("")
  photoQuery        String   @default("nablus palestine city")
  imageUrl          String? // رابط صورة حقيقية رفعها الأدمن (لو موجودة)
  iconCodePoint     Int      @default(58719) // Icons.place (0xe55f)
  colorValue        Int      @default(3946230) // لون RGB فقط بدون بايت الشفافية (0x3B82F6)
  // تعليق مؤقت للصيانة (يحدده الأدمن بمدة، وممكن ينهيه يدويًا أبكر) — انظر شرح
  // مطابق أسفل نموذج Restaurant.
  suspendedUntil    DateTime?
  suspendReason     String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category])
}

// ==================== الفنادق ====================
model Hotel {
  id            String   @id @default(cuid())
  nameAr        String
  nameEn        String
  typeAr        String   @default("")
  typeEn        String   @default("")
  locationAr    String
  locationEn    String
  rating        Float    @default(4.0)
  reviews       Int      @default(0)
  priceInfoAr   String   @default("")
  priceInfoEn   String   @default("")
  priceTier     String   @default("medium") // cheap | medium | high
  hoursAr       String   @default("")
  hoursEn       String   @default("")
  aboutAr       String   @default("")
  aboutEn       String   @default("")
  phone         String   @default("")
  imageUrl      String?
  gallery       String   @default("") // مسارات صور مفصولة بفواصل
  amenities     String   @default("") // wifi,parking,restaurant,roomService (مفصولة بفواصل)
  tags          String   @default("") // nearOldCity,nearUniversity,luxury... (مفصولة بفواصل)
  iconCodePoint Int      @default(58719)
  colorValue    Int      @default(7114727) // 0x6C5CE7
  isFeatured    Boolean  @default(false)
  lat           Float? // إحداثيات دقيقة حدّدها الأدمن بالضغط على الخريطة
  lng           Float?
  ownerEmail    String   @default("") // بريد صاحب المحل (User.email) لو مرتبط بحساب — فاضي يعني بدون مالك
  // تعليق مؤقت للصيانة: الأدمن بيحدد تاريخ/وقت انتهاء التعليق (suspendedUntil)،
  // والمكان بيرجع نشط تلقائيًا (بالحساب فقط، بدون مهمة مجدولة) لما الوقت الحالي
  // يتخطاه — أو الأدمن يقدر يلغي التعليق يدويًا قبل الموعد لو خلصت الصيانة أبكر.
  suspendedUntil DateTime?
  suspendReason  String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==================== الصيدليات ====================
model Pharmacy {
  id          String   @id @default(cuid())
  nameAr      String
  nameEn      String
  locationAr  String
  locationEn  String
  rating      Float    @default(4.0)
  reviews     Int      @default(0)
  hoursAr     String   @default("")
  hoursEn     String   @default("")
  is24Hours   Boolean  @default(false)
  hasDelivery Boolean  @default(false)
  aboutAr     String   @default("")
  aboutEn     String   @default("")
  phone       String   @default("")
  imageUrl    String?
  tags        String   @default("") // nearHospital... (مفصولة بفواصل)
  iconCodePoint Int    @default(59691) // Icons.local_pharmacy
  colorValue  Int      @default(3946230)
  isFeatured  Boolean  @default(false)
  lat         Float?
  lng         Float?
  ownerEmail  String   @default("")
  suspendedUntil DateTime?
  suspendReason  String @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== المعالم السياحية ====================
model Attraction {
  id            String   @id @default(cuid())
  nameAr        String
  nameEn        String
  categories    String   @default("") // historical,religious,nature,oldCity,culture (مفصولة بفواصل)
  locationAr    String
  locationEn    String
  rating        Float    @default(4.0)
  reviews       Int      @default(0)
  aboutAr       String   @default("")
  aboutEn       String   @default("")
  visitHoursAr  String   @default("")
  visitHoursEn  String   @default("")
  entryFeeAr    String   @default("")
  entryFeeEn    String   @default("")
  imageUrl      String?
  iconCodePoint Int      @default(59217) // Icons.account_balance
  colorValue    Int      @default(13217575) // 0xC9A227
  isFeatured    Boolean  @default(false)
  lat           Float?
  lng           Float?
  suspendedUntil DateTime?
  suspendReason  String @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==================== المراكز التجارية (تسوق) ====================
model ShoppingVenue {
  id            String   @id @default(cuid())
  nameAr        String
  nameEn        String
  typeAr        String   @default("")
  typeEn        String   @default("")
  locationAr    String
  locationEn    String
  rating        Float    @default(4.0)
  reviews       Int      @default(0)
  hoursAr       String   @default("")
  hoursEn       String   @default("")
  aboutAr       String   @default("")
  aboutEn       String   @default("")
  phone         String   @default("")
  imageUrl      String?
  iconCodePoint Int      @default(58728) // Icons.shopping_bag
  colorValue    Int      @default(3900918) // 0x3B82F6
  isFeatured    Boolean  @default(false)
  lat           Float?
  lng           Float?
  subCategory   String   @default("") // fashion | shoes | electronics | cosmetics | jewelry | books | entertainment
  website       String   @default("")
  ownerEmail    String   @default("")
  suspendedUntil DateTime?
  suspendReason  String @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==================== المطاعم ====================
model Restaurant {
  id            String   @id @default(cuid())
  nameAr        String
  nameEn        String
  categoryAr    String
  categoryEn    String
  cuisineKey    String // traditional | eastern | cafe | fastfood | sweets | italian
  locationAr    String
  locationEn    String
  rating        Float    @default(4.0)
  reviews       Int      @default(0)
  priceRange    String   @default("")
  priceTier     String   @default("medium") // cheap | medium | high
  time          String   @default("")
  aboutAr       String   @default("")
  aboutEn       String   @default("")
  phone         String   @default("")
  imageUrl      String?
  iconCodePoint Int      @default(58732) // Icons.restaurant (0xe56c)
  colorValue    Int      @default(7114727) // لون RGB فقط بدون بايت الشفافية (0x6C5CE7)
  lat           Float?
  lng           Float?
  ownerEmail    String   @default("")
  // تعليق مؤقت للصيانة (يحدده الأدمن بمدة، وممكن ينهيه يدويًا أبكر لو خلصت
  // الصيانة قبل الموعد) — المكان بيرجع نشط تلقائيًا بالحساب لما suspendedUntil يمضي.
  suspendedUntil DateTime?
  suspendReason  String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([cuisineKey])
}

// ==================== الأخبار ====================
model NewsArticle {
  id          String   @id @default(cuid())
  titleAr     String
  titleEn     String
  dateAr      String
  dateEn      String
  categoryAr  String
  categoryEn  String
  categoryKey String // tourism | events | development | culture
  summaryAr   String   @default("")
  summaryEn   String   @default("")
  bodyAr      String   @default("")
  bodyEn      String   @default("")
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryKey])
}

// ==================== الفعاليات القادمة ====================
model Event {
  id            String   @id @default(cuid())
  titleAr       String
  titleEn       String
  venueAr       String   @default("")
  venueEn       String   @default("")
  day           String   @default("")
  monthAr       String   @default("")
  monthEn       String   @default("")
  timeAr        String   @default("")
  timeEn        String   @default("")
  aboutAr       String   @default("")
  aboutEn       String   @default("")
  photoQuery    String   @default("nablus palestine city")
  imageUrl      String?
  iconCodePoint Int      @default(57918) // Icons.event (0xe23e)
  colorValue    Int      @default(3946230) // 0x3B82F6
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==================== عدّاد الزوار ====================
// صف واحد ثابت (id = "main") بيتزاد رقمه كل ما حد يفتح التطبيق.
model VisitCounter {
  id    String @id @default("main")
  count Int    @default(0)
}

// ==================== صور أيقونات التصنيفات ====================
// صورة واحدة رفعها الأدمن لكل تصنيف رئيسي (مطاعم/فنادق/صحة...) — تظهر لكل
// الزوار فورًا بدون أي تعديل بكود التطبيق. categoryKey يطابق نفس اسم الصندوق
// المحلي (boxName) المستخدم بالتطبيق (transport/health/...)، بالإضافة لمفتاح
// "more" الخاص بمربّع "المزيد" بالصفحة الرئيسية.
model CategoryImage {
  id          String   @id @default(cuid())
  categoryKey String   @unique
  imageUrl    String?
  updatedAt   DateTime @updatedAt
}

// ==================== المفضلة وسجل الزيارات (حسابات حقيقية مُتزامنة) ====================
// userEmail هو مفتاح الربط بالمستخدم (مطابق User.email) — نفس مفتاح النطاق
// (scope) المستخدم أصلًا محليًا بـ Hive، فما في داعي لأي هجرة بيانات.
model Favorite {
  id        String   @id @default(cuid())
  userEmail String
  nameEn    String
  createdAt DateTime @default(now())

  @@unique([userEmail, nameEn])
  @@index([userEmail])
}

model PlaceView {
  id        String   @id @default(cuid())
  userEmail String
  nameEn    String
  viewedAt  DateTime @default(now())

  @@index([userEmail])
}

// ==================== تقييمات ومراجعات حقيقية من المستخدمين ====================
// مرتبطة بالمكان عبر (placeType, placeNameEn) وليس id — نفس مفتاح الربط
// المستخدم أصلًا بكل مكان بالتطبيق (nameEn)، حتى تشتغل مع كل الأماكن (بيانات
// الكود الثابتة وبيانات السيرفر) بدون فرق. مراجعة وحدة لكل مستخدم لكل مكان
// (upsert) بدل سماح بمراجعات مكررة.
model Review {
  id          String   @id @default(cuid())
  userEmail   String
  userName    String
  placeType   String // restaurant | hotel | pharmacy | attraction | shopping | transport | health | ...
  placeNameEn String
  rating      Int // 1-5
  comment     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userEmail, placeType, placeNameEn])
  @@index([placeType, placeNameEn])
}

// ==================== رسائل تواصل/بلاغات الزوار (متزامنة مع السيرفر) ====================
model Feedback {
  id           String    @id @default(cuid())
  name         String
  email        String    @default("")
  type         String // suggestion | issue | question
  message      String
  relatedPlace String?
  read         Boolean   @default(false)
  reply        String?
  repliedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([email])
}

// ==================== حواجز (حالة يدوية من الإدارة فقط — مش بيانات حية/GPS) ====================
// ما عنا أي مصدر بيانات حي لحالة الحواجز الفعلية، فالحالة هون لازم تُحدَّث يدويًا
// من أدمن حقيقي بعد تحقق فعلي — الافتراضي "unknown" لحتى ما نفترض حالة ممكن تكون
// غلط وتوقع حدا بموقف صعب. status: unknown | open | congested | closed
model Checkpoint {
  id         String   @id @default(cuid())
  nameAr     String
  nameEn     String   @unique
  locationAr String   @default("")
  locationEn String   @default("")
  status     String   @default("unknown")
  altRouteAr String   @default("")
  altRouteEn String   @default("")
  updatedBy  String   @default("") // بريد الأدمن اللي حدّث آخر مرة (شفافية)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ==================== تنبيه ازدحام واحد نشط (منشور يدويًا من أدمن حقيقي) ====================
// مش بيانات مرورية حية تلقائية — مجرد إعلان نصي بينشره أدمن، زي منشور، وبيظهر
// لكل المستخدمين لحد ما يمسحه/يعدّله.
model TrafficAlert {
  id         String   @id @default(cuid())
  active     Boolean  @default(false)
  textAr     String   @default("")
  textEn     String   @default("")
  altRouteAr String   @default("")
  altRouteEn String   @default("")
  updatedBy  String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ==================== عروض/إعلانات محلات حقيقية (خصم، توصيل مجاني، كود خصم...) ====================
// إعلان داخلي بينشره الأدمن لمحل حقيقي موجود بالتطبيق — بعكس isFeatured (يظهر
// المحل نفسه أولًا بشكل دائم)، هاي عرض بعنوان/تفاصيل واضحة وبفترة صلاحية اختيارية
// (مثلاً عرض عيد الحب أو رأس السنة)، وبيختفي تلقائيًا بعد تاريخ الانتهاء.
model Promotion {
  id            String    @id @default(cuid())
  titleAr       String
  titleEn       String
  descriptionAr String    @default("")
  descriptionEn String    @default("")
  discountCode  String    @default("")
  placeNameAr   String    @default("")
  placeNameEn   String    @default("")
  categoryKey   String    @default("") // لفتح فئة المحل الصح لو ضغط المستخدم عليه (restaurants/shopping/hotels...)
  imageUrl      String?
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ==================== طلبات ملكية المحلات (صاحب مطعم/فندق/صيدلية/محل يطلب ربط حسابه بمحله) ====================
// بعد موافقة الأدمن، بيتحدّث ownerEmail على المحل نفسه (بجدوله المخصص) — هاد
// الجدول بيحتفظ فقط بسجل الطلب وحالته (pending/approved/rejected) للمراجعة.
model OwnershipRequest {
  id             String   @id @default(cuid())
  placeType      String // restaurant | hotel | pharmacy | shopping
  placeId        String
  placeNameAr    String   @default("")
  placeNameEn    String   @default("")
  requesterEmail String
  requesterName  String   @default("")
  message        String   @default("") // ملاحظة اختيارية من صاحب الطلب (مثلاً وسيلة إثبات ملكية)
  status         String   @default("pending") // pending | approved | rejected
  reviewedBy     String   @default("") // بريد الأدمن اللي راجع الطلب
  reviewNote     String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([requesterEmail])
}
